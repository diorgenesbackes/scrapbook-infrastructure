{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Sinais da preparação de mídias e alarmes das DLQs existentes da F10",
  "Parameters": {
    "MonitoringName": {"Type": "String", "AllowedPattern": "[a-z0-9][a-z0-9-]{2,39}"},
    "ServiceLogGroupName": {"Type": "String", "AllowedPattern": "[A-Za-z0-9._/#-]{1,512}"},
    "ConfirmationDlqName": {"Type": "String", "AllowedPattern": "[A-Za-z0-9_-]{1,80}"},
    "ResultDlqName": {"Type": "String", "AllowedPattern": "[A-Za-z0-9_-]{1,80}"},
    "DeliveryDlqName": {"Type": "String", "AllowedPattern": "[A-Za-z0-9_-]{1,80}"},
    "AlarmTopicArn": {
      "Type": "String",
      "Default": "",
      "AllowedPattern": "(?:arn:(aws|aws-cn|aws-us-gov):sns:[a-z0-9-]+:[0-9]{12}:[A-Za-z0-9_-]+)?"
    }
  },
  "Conditions": {"AlarmNotificationsEnabled": {"Fn::Not": [{"Fn::Equals": [{"Ref": "AlarmTopicArn"}, ""]}]}},
  "Resources": {
    "ProcessingSamples": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "FilterName": {"Fn::Sub": "${MonitoringName}-ProcessingSamples"},
        "LogGroupName": {"Ref": "ServiceLogGroupName"},
        "FilterPattern": "{ ($.serviceName = \"scrapbook-backend\") && ($.eventName = \"media.processing.interval\") && ($.sampleCount >= 0) }",
        "MetricTransformations": [
          {
            "MetricNamespace": {"Fn::Sub": "ScrapBook/Media/${MonitoringName}"},
            "MetricName": "ProcessingSamples",
            "MetricValue": "$.sampleCount",
            "Unit": "Count",
            "Dimensions": [
              {"Key": "Stage", "Value": "$.stage"},
              {"Key": "MediaType", "Value": "$.mediaType"},
              {"Key": "Outcome", "Value": "$.outcome"}
            ]
          }
        ]
      }
    },
    "ProcessingDurationSumSeconds": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "FilterName": {"Fn::Sub": "${MonitoringName}-ProcessingDurationSumSeconds"},
        "LogGroupName": {"Ref": "ServiceLogGroupName"},
        "FilterPattern": "{ ($.serviceName = \"scrapbook-backend\") && ($.eventName = \"media.processing.interval\") && ($.durationSumSeconds >= 0) && ($.stage != \"ready\") && ($.durationSampleCount > 0) }",
        "MetricTransformations": [
          {
            "MetricNamespace": {"Fn::Sub": "ScrapBook/Media/${MonitoringName}"},
            "MetricName": "ProcessingDurationSumSeconds",
            "MetricValue": "$.durationSumSeconds",
            "Unit": "Seconds",
            "Dimensions": [
              {"Key": "Stage", "Value": "$.stage"},
              {"Key": "MediaType", "Value": "$.mediaType"},
              {"Key": "Cohort", "Value": "$.cohort"}
            ]
          }
        ]
      }
    },
    "ProcessingDurationSamples": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "FilterName": {"Fn::Sub": "${MonitoringName}-ProcessingDurationSamples"},
        "LogGroupName": {"Ref": "ServiceLogGroupName"},
        "FilterPattern": "{ ($.serviceName = \"scrapbook-backend\") && ($.eventName = \"media.processing.interval\") && ($.durationSampleCount >= 0) && ($.stage != \"ready\") }",
        "MetricTransformations": [
          {
            "MetricNamespace": {"Fn::Sub": "ScrapBook/Media/${MonitoringName}"},
            "MetricName": "ProcessingDurationSamples",
            "MetricValue": "$.durationSampleCount",
            "Unit": "Count",
            "Dimensions": [
              {"Key": "Stage", "Value": "$.stage"},
              {"Key": "MediaType", "Value": "$.mediaType"},
              {"Key": "Cohort", "Value": "$.cohort"}
            ]
          }
        ]
      }
    },
    "ReadyDurationSumSeconds": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "FilterName": {"Fn::Sub": "${MonitoringName}-ReadyDurationSumSeconds"},
        "LogGroupName": {"Ref": "ServiceLogGroupName"},
        "FilterPattern": "{ ($.serviceName = \"scrapbook-backend\") && ($.eventName = \"media.processing.interval\") && ($.durationSumSeconds >= 0) && ($.stage = \"ready\") && ($.outcome = \"available\") }",
        "MetricTransformations": [
          {
            "MetricNamespace": {"Fn::Sub": "ScrapBook/Media/${MonitoringName}"},
            "MetricName": "ReadyDurationSumSeconds",
            "MetricValue": "$.durationSumSeconds",
            "Unit": "Seconds",
            "Dimensions": [{"Key": "MediaType", "Value": "$.mediaType"}, {"Key": "Cohort", "Value": "$.cohort"}]
          }
        ]
      }
    },
    "ReadyMaximumSeconds": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "FilterName": {"Fn::Sub": "${MonitoringName}-ReadyMaximumSeconds"},
        "LogGroupName": {"Ref": "ServiceLogGroupName"},
        "FilterPattern": "{ ($.serviceName = \"scrapbook-backend\") && ($.eventName = \"media.processing.interval\") && ($.durationMaximumSeconds >= 0) && ($.stage = \"ready\") && ($.outcome = \"available\") }",
        "MetricTransformations": [
          {
            "MetricNamespace": {"Fn::Sub": "ScrapBook/Media/${MonitoringName}"},
            "MetricName": "ReadyMaximumSeconds",
            "MetricValue": "$.durationMaximumSeconds",
            "Unit": "Seconds",
            "Dimensions": [{"Key": "MediaType", "Value": "$.mediaType"}, {"Key": "Cohort", "Value": "$.cohort"}]
          }
        ]
      }
    },
    "ReadyWithinTarget": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "FilterName": {"Fn::Sub": "${MonitoringName}-ReadyWithinTarget"},
        "LogGroupName": {"Ref": "ServiceLogGroupName"},
        "FilterPattern": "{ ($.serviceName = \"scrapbook-backend\") && ($.eventName = \"media.processing.interval\") && ($.withinTargetCount >= 0) && ($.stage = \"ready\") && ($.outcome = \"available\") }",
        "MetricTransformations": [
          {
            "MetricNamespace": {"Fn::Sub": "ScrapBook/Media/${MonitoringName}"},
            "MetricName": "ReadyWithinTarget",
            "MetricValue": "$.withinTargetCount",
            "Unit": "Count",
            "Dimensions": [{"Key": "MediaType", "Value": "$.mediaType"}, {"Key": "Cohort", "Value": "$.cohort"}]
          }
        ]
      }
    },
    "ReadySamples": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "FilterName": {"Fn::Sub": "${MonitoringName}-ReadySamples"},
        "LogGroupName": {"Ref": "ServiceLogGroupName"},
        "FilterPattern": "{ ($.serviceName = \"scrapbook-backend\") && ($.eventName = \"media.processing.interval\") && ($.sampleCount >= 0) && ($.stage = \"ready\") && ($.outcome = \"available\") }",
        "MetricTransformations": [
          {
            "MetricNamespace": {"Fn::Sub": "ScrapBook/Media/${MonitoringName}"},
            "MetricName": "ReadySamples",
            "MetricValue": "$.sampleCount",
            "Unit": "Count",
            "Dimensions": [{"Key": "MediaType", "Value": "$.mediaType"}, {"Key": "Cohort", "Value": "$.cohort"}]
          }
        ]
      }
    },
    "OutboxPending": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "FilterName": {"Fn::Sub": "${MonitoringName}-OutboxPending"},
        "LogGroupName": {"Ref": "ServiceLogGroupName"},
        "FilterPattern": "{ ($.serviceName = \"scrapbook-backend\") && ($.eventName = \"media.processing.outbox_sample\") && ($.pendingCount >= 0) }",
        "MetricTransformations": [
          {
            "MetricNamespace": {"Fn::Sub": "ScrapBook/Media/${MonitoringName}"},
            "MetricName": "OutboxPending",
            "MetricValue": "$.pendingCount",
            "Unit": "Count"
          }
        ]
      }
    },
    "OutboxFailed": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "FilterName": {"Fn::Sub": "${MonitoringName}-OutboxFailed"},
        "LogGroupName": {"Ref": "ServiceLogGroupName"},
        "FilterPattern": "{ ($.serviceName = \"scrapbook-backend\") && ($.eventName = \"media.processing.outbox_sample\") && ($.failedCount >= 0) }",
        "MetricTransformations": [
          {
            "MetricNamespace": {"Fn::Sub": "ScrapBook/Media/${MonitoringName}"},
            "MetricName": "OutboxFailed",
            "MetricValue": "$.failedCount",
            "Unit": "Count"
          }
        ]
      }
    },
    "OutboxOldestAgeSeconds": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "FilterName": {"Fn::Sub": "${MonitoringName}-OutboxOldestAgeSeconds"},
        "LogGroupName": {"Ref": "ServiceLogGroupName"},
        "FilterPattern": "{ ($.serviceName = \"scrapbook-backend\") && ($.eventName = \"media.processing.outbox_sample\") && ($.oldestPendingAgeSeconds >= 0) }",
        "MetricTransformations": [
          {
            "MetricNamespace": {"Fn::Sub": "ScrapBook/Media/${MonitoringName}"},
            "MetricName": "OutboxOldestAgeSeconds",
            "MetricValue": "$.oldestPendingAgeSeconds",
            "Unit": "Seconds"
          }
        ]
      }
    },
    "JobsPending": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "FilterName": {"Fn::Sub": "${MonitoringName}-JobsPending"},
        "LogGroupName": {"Ref": "ServiceLogGroupName"},
        "FilterPattern": "{ ($.serviceName = \"scrapbook-backend\") && ($.eventName = \"media.processing.jobs_sample\") && ($.pendingCount >= 0) }",
        "MetricTransformations": [
          {
            "MetricNamespace": {"Fn::Sub": "ScrapBook/Media/${MonitoringName}"},
            "MetricName": "JobsPending",
            "MetricValue": "$.pendingCount",
            "Unit": "Count",
            "Dimensions": [{"Key": "MediaType", "Value": "$.mediaType"}, {"Key": "Cohort", "Value": "$.cohort"}]
          }
        ]
      }
    },
    "JobsActive": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "FilterName": {"Fn::Sub": "${MonitoringName}-JobsActive"},
        "LogGroupName": {"Ref": "ServiceLogGroupName"},
        "FilterPattern": "{ ($.serviceName = \"scrapbook-backend\") && ($.eventName = \"media.processing.jobs_sample\") && ($.activeCount >= 0) }",
        "MetricTransformations": [
          {
            "MetricNamespace": {"Fn::Sub": "ScrapBook/Media/${MonitoringName}"},
            "MetricName": "JobsActive",
            "MetricValue": "$.activeCount",
            "Unit": "Count",
            "Dimensions": [{"Key": "MediaType", "Value": "$.mediaType"}, {"Key": "Cohort", "Value": "$.cohort"}]
          }
        ]
      }
    },
    "JobsReconciling": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "FilterName": {"Fn::Sub": "${MonitoringName}-JobsReconciling"},
        "LogGroupName": {"Ref": "ServiceLogGroupName"},
        "FilterPattern": "{ ($.serviceName = \"scrapbook-backend\") && ($.eventName = \"media.processing.jobs_sample\") && ($.reconcilingCount >= 0) }",
        "MetricTransformations": [
          {
            "MetricNamespace": {"Fn::Sub": "ScrapBook/Media/${MonitoringName}"},
            "MetricName": "JobsReconciling",
            "MetricValue": "$.reconcilingCount",
            "Unit": "Count",
            "Dimensions": [{"Key": "MediaType", "Value": "$.mediaType"}, {"Key": "Cohort", "Value": "$.cohort"}]
          }
        ]
      }
    },
    "JobsOldestAgeSeconds": {
      "Type": "AWS::Logs::MetricFilter",
      "Properties": {
        "FilterName": {"Fn::Sub": "${MonitoringName}-JobsOldestAgeSeconds"},
        "LogGroupName": {"Ref": "ServiceLogGroupName"},
        "FilterPattern": "{ ($.serviceName = \"scrapbook-backend\") && ($.eventName = \"media.processing.jobs_sample\") && ($.oldestPendingAgeSeconds >= 0) }",
        "MetricTransformations": [
          {
            "MetricNamespace": {"Fn::Sub": "ScrapBook/Media/${MonitoringName}"},
            "MetricName": "JobsOldestAgeSeconds",
            "MetricValue": "$.oldestPendingAgeSeconds",
            "Unit": "Seconds",
            "Dimensions": [{"Key": "MediaType", "Value": "$.mediaType"}, {"Key": "Cohort", "Value": "$.cohort"}]
          }
        ]
      }
    },
    "ConfirmationDlqVisible": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": {"Fn::Sub": "${MonitoringName}-confirmation-dlq-visible"},
        "AlarmDescription": "A fila de falhas de preparação de mídias contém mensagens disponíveis para inspeção.",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [{"Name": "QueueName", "Value": {"Ref": "ConfirmationDlqName"}}],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": {"Fn::If": ["AlarmNotificationsEnabled", [{"Ref": "AlarmTopicArn"}], {"Ref": "AWS::NoValue"}]}
      }
    },
    "ResultDlqVisible": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": {"Fn::Sub": "${MonitoringName}-result-dlq-visible"},
        "AlarmDescription": "A fila de falhas de preparação de mídias contém mensagens disponíveis para inspeção.",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [{"Name": "QueueName", "Value": {"Ref": "ResultDlqName"}}],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": {"Fn::If": ["AlarmNotificationsEnabled", [{"Ref": "AlarmTopicArn"}], {"Ref": "AWS::NoValue"}]}
      }
    },
    "DeliveryDlqVisible": {
      "Type": "AWS::CloudWatch::Alarm",
      "Properties": {
        "AlarmName": {"Fn::Sub": "${MonitoringName}-delivery-dlq-visible"},
        "AlarmDescription": "A fila de falhas de preparação de mídias contém mensagens disponíveis para inspeção.",
        "Namespace": "AWS/SQS",
        "MetricName": "ApproximateNumberOfMessagesVisible",
        "Dimensions": [{"Name": "QueueName", "Value": {"Ref": "DeliveryDlqName"}}],
        "Statistic": "Maximum",
        "Period": 60,
        "EvaluationPeriods": 1,
        "Threshold": 1,
        "ComparisonOperator": "GreaterThanOrEqualToThreshold",
        "TreatMissingData": "notBreaching",
        "AlarmActions": {"Fn::If": ["AlarmNotificationsEnabled", [{"Ref": "AlarmTopicArn"}], {"Ref": "AWS::NoValue"}]}
      }
    }
  },
  "Outputs": {"MediaMetricNamespace": {"Value": {"Fn::Sub": "ScrapBook/Media/${MonitoringName}"}}}
}
